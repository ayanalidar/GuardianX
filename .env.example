# ── GuardianX Environment Variables ──────────────────────────────────────────
# Copy this file to .env and fill in the values.

# For LOCAL DEVELOPMENT (SQLite):
DATABASE_URL="file:./db/custom.db"

# For PRODUCTION (Supabase PostgreSQL):
# DATABASE_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"

# Encryption key (generate with: openssl rand -base64 32)
SENTINEL_ENC_KEY="generate_with_openssl_rand_base64_32"

# Node environment
NODE_ENV="production"

# Railway engine URL (for socket.io + sandbox execution)
# After deploying sentinel-engine on Railway, set this to the Railway URL
ENGINE_URL="https://your-railway-app.up.railway.app"

# For local development, the engine runs on localhost:3003
# ENGINE_URL="http://localhost:3003"
