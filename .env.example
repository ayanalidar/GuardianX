# ── GuardianX Environment Variables (Supabase REST API — works on Vercel!) ──

# Supabase (HTTPS port 443 — works on Vercel serverless)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Encryption key (openssl rand -base64 32)
SENTINEL_ENC_KEY=YOUR_KEY

# Node environment
NODE_ENV=production

# Railway engine URL (for socket.io + sandbox)
ENGINE_URL=https://your-railway-app.up.railway.app
