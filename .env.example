# GuardianX Production Environment
# Copy this to .env.production and fill in your values
# NEVER commit .env.production to git

# ── Platform ───────────────────────────────────────────────────────────────
# Public web platform URL (where users visit the website).
# NOTE: SMTP/mailbox remains on guardianx.in via Hostinger — see SMTP_USER below.
NEXT_PUBLIC_SITE_URL=https://guardianx.cloud

# ── Supabase ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Security (generate with: openssl rand -hex 32) ────────────────────────
JWT_SECRET=generate-a-64-char-hex-secret-here
BREAK_GLASS_KEY=generate-another-64-char-hex-secret-here

# ── SMTP (Hostinger) ───────────────────────────────────────────────────────
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=hello@guardianx.in
SMTP_PASS=your-mailbox-password
SMTP_FROM="GuardianX <hello@guardianx.in>"

# ── Engine ─────────────────────────────────────────────────────────────────
ENGINE_URL=http://sentinel-engine:3003
RECON_TOOLS_URL=http://recon-tools:3004
ENGINE_INTERNAL_KEY=optional-shared-secret-between-app-and-engine

# ── Sentry (optional — error tracking) ────────────────────────────────────
SENTRY_DSN=

# ── Stripe (optional — billing) ───────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Z.AI SDK (for AI features) ─────────────────────────────────────────────
# The SDK reads from /etc/.z-ai-config or env vars
ZAI_API_KEY=your-zai-api-key
ZAI_BASE_URL=https://internal-api.z.ai/v1
