// GuardianX — Production schema (PostgreSQL via Supabase pooler)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Client (top-level entity — groups all assets + pipeline stages) ──────
model Client {
  id           String   @id @default(cuid())
  name         String
  description  String?
  contactName  String?
  contactEmail String?
  contactPhone String?
  targetUrl    String?
  repoUrl      String?
  scope        String?
  authorized   Boolean  @default(false)
  frameworks   String?  // comma-separated: "DPDPA,GDPR,PCI-DSS"
  status       String   @default("onboarding")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  codebases    Codebase[]
  targets      Target[]
}

model Codebase {
  id          String   @id @default(cuid())
  name        String
  language    String   @default("javascript")
  description String?
  sourceCode  String
  clientId    String?
  client      Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  scans       Scan[]
  patches     Patch[]
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  password      String
  role          String   @default("viewer")
  avatar        String?
  twofaSecret   String?
  twofaEnabled  Boolean  @default(false)
  backupCodes   String?
  approved      Boolean  @default(false)
  tokenVersion  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Scan {
  id          String   @id @default(cuid())
  codebaseId  String
  codebase    Codebase @relation(fields: [codebaseId], references: [id], onDelete: Cascade)
  status      String   @default("queued")
  stageLabel  String?
  startedAt   DateTime @default(now())
  completedAt DateTime?
  patches     Patch[]
  events      PipelineEvent[]
}

model Patch {
  id             String   @id @default(cuid())
  patchId        String   @unique
  codebaseId     String
  codebase       Codebase @relation(fields: [codebaseId], references: [id], onDelete: Cascade)
  scanId         String
  scan           Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)
  title          String
  severity       String
  cve            String?
  affectedFile   String
  aiExplanation  String
  aiReasoning    String
  confidence     Float    @default(0)
  originalCode   String
  patchedCode    String
  diffPayload    String
  testCode       String
  sandboxLogs    String
  sandboxPassed  Boolean  @default(false)
  exploitCode    String?
  exploitOriginalResult String?
  exploitPatchedResult  String?
  adversarialRounds    Int      @default(0)
  adversarialWon       Boolean  @default(false)
  adversarialTranscript String?
  status         String   @default("pending")
  createdAt      DateTime @default(now())
  approvedAt     DateTime?
  chatMessages   ChatMessage[]
  attestations   Attestation[]
}

model PipelineEvent {
  id        String   @id @default(cuid())
  scanId    String
  scan      Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)
  stage     String
  message   String
  level     String   @default("info")
  meta      String?
  createdAt DateTime @default(now())
}

model ChatMessage {
  id        String   @id @default(cuid())
  patchId   String
  patch     Patch    @relation(fields: [patchId], references: [id], onDelete: Cascade)
  role      String
  content   String
  createdAt DateTime @default(now())
}

model Credential {
  id          String   @id @default(cuid())
  label       String
  kind        String
  target      String
  username    String?
  secretCipher String
  secretIv    String
  secretTag   String
  createdAt   DateTime @default(now())
  lastUsedAt  DateTime?
  audits      CredentialAudit[]
}

model CredentialAudit {
  id           String   @id @default(cuid())
  credentialId String
  credential   Credential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  action       String
  context      String?
  createdAt    DateTime @default(now())
}

model Target {
  id          String   @id @default(cuid())
  name        String
  baseUrl     String
  authHeader  String?
  notes       String?
  authorized  Boolean  @default(false)
  clientId    String?
  client      Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  engagements Engagement[]
}

model Engagement {
  id          String   @id @default(cuid())
  targetId    String
  target      Target   @relation(fields: [targetId], references: [id], onDelete: Cascade)
  status      String   @default("queued")
  stageLabel  String?
  crawlSummary String?
  startedAt   DateTime @default(now())
  completedAt DateTime?
  findings    Finding[]
  events      RedAgentEvent[]
}

model Finding {
  id           String   @id @default(cuid())
  engagementId String
  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  title        String
  severity     String
  category     String
  owasp        String?
  endpoint     String
  method       String
  description  String
  proofRequest String
  proofResponse String
  payload      String?
  confidence   Float    @default(0)
  remediation  String?
  createdAt    DateTime @default(now())
}

model RedAgentEvent {
  id           String   @id @default(cuid())
  engagementId String
  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  stage        String
  message      String
  level        String   @default("info")
  meta         String?
  createdAt    DateTime @default(now())
}

model Attestation {
  id        String   @id @default(cuid())
  patchId   String   @unique
  patch     Patch    @relation(fields: [patchId], references: [id], onDelete: Cascade)
  prevHash  String
  hash      String
  data      String
  createdAt DateTime @default(now())
}

model Canary {
  id          String   @id @default(cuid())
  targetId    String?
  label       String
  canaryType  String
  canaryValue String   @unique
  injectedEndpoint String
  isActive    Boolean  @default(true)
  detected    Boolean  @default(false)
  detectedAt  DateTime?
  detectedOn  String?
  createdAt   DateTime @default(now())
}

model ApiAccessLog {
  id          String   @id @default(cuid())
  targetId    String?
  ipAddress   String
  method      String
  endpoint    String
  statusCode  Int
  userAgent   String
  responseSize Int
  timestamp   DateTime @default(now())
}

model HoneypotHit {
  id          String   @id @default(cuid())
  targetId    String?
  endpoint    String
  ipAddress   String
  userAgent   String
  method      String   @default("GET")
  timestamp   DateTime @default(now())
  // ── self-security-extend ────────────────────────────────────────────────
  // Fields added for the self-security task (Honeypot-as-Defense innovation).
  payload     String   @default("")
  severity    String   @default("high")
  detectedAt  DateTime @default(now())
  blockedAt   DateTime?
  status      String   @default("logged")

  @@index([ipAddress])
  @@index([detectedAt])
}

// ── Self-Security: Runtime Integrity Incidents ───────────────────────────────
// Created whenever the middleware's runtime integrity check detects that one
// or more critical source files have been tampered with. Mirrors the local
// prisma/schema.prisma definition — do NOT diverge.
model IntegrityIncident {
  id            String   @id @default(cuid())
  tamperedFiles String
  detectedAt    DateTime @default(now())
  resolvedAt    DateTime?
  status        String   @default("open")
  notes         String?

  @@index([detectedAt])
  @@index([status])
}

model WebhookConfig {
  id          String   @id @default(cuid())
  name        String
  url         String
  events      String
  isActive    Boolean  @default(true)
  secret      String?
  createdAt   DateTime @default(now())
}

model ScheduledScan {
  id          String   @id @default(cuid())
  name        String
  scanType    String
  targetId    String?
  codebaseId  String?
  cronExpr    String
  isActive    Boolean  @default(true)
  lastRunAt   DateTime?
  nextRunAt   DateTime?
  createdAt   DateTime @default(now())
}

model AlertRule {
  id          String   @id @default(cuid())
  name        String
  condition   String
  channel     String
  channelConfig String
  isActive    Boolean  @default(true)
  lastTriggered DateTime?
  createdAt   DateTime @default(now())
}

model AuditLog {
  id          String   @id @default(cuid())
  action      String
  entity      String?
  actor       String   @default("system")
  details     String?
  createdAt   DateTime @default(now())
}

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  createdAt   DateTime @default(now())
  members     TeamMember[]
}

model TeamMember {
  id          String   @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  email       String
  role        String   @default("viewer")
  invitedAt   DateTime @default(now())
  joinedAt    DateTime?
}

model AttackChain {
  id          String   @id @default(cuid())
  title       String
  description String
  severity    String
  steps       String
  findingIds  String?
  createdAt   DateTime @default(now())
}

model Integration {
  id          String   @id @default(cuid())
  type        String
  config      String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model FuzzResult {
  id          String   @id @default(cuid())
  targetUrl   String
  endpoint    String
  method      String
  totalRequests Int
  crashes     Int
  errors      Int
  anomalies   String?
  createdAt   DateTime @default(now())
}

model Incident {
  id              String   @id @default(cuid())
  title           String
  description     String?
  severity        String   @default("medium")
  status          String   @default("open")
  category        String   @default("other")
  source          String   @default("manual")
  sourceId        String?
  clientId        String?
  targetId        String?
  assignee        String?
  detectedAt      DateTime @default(now())
  containedAt     DateTime?
  eradicatedAt    DateTime?
  closedAt        DateTime?
  rootCause       String?
  lessonsLearned  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  events          IncidentEvent[]
  evidence        Evidence[]
}

model IncidentEvent {
  id          String   @id @default(cuid())
  incidentId  String
  incident    Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  eventType   String
  source      String
  sourceId    String?
  title       String
  description String?
  severity    String   @default("info")
  metadata    String?
  actor       String?
  occurredAt  DateTime @default(now())
  createdAt   DateTime @default(now())
}

model IOC {
  id          String   @id @default(cuid())
  iocType     String
  value       String   @unique
  confidence  String   @default("medium")
  source      String   @default("internal")
  tags        String?
  firstSeen   DateTime @default(now())
  lastSeen    DateTime @default(now())
  hitCount    Int      @default(1)
  isActive    Boolean  @default(true)
  notes       String?
  createdAt   DateTime @default(now())
}

model Evidence {
  id              String   @id @default(cuid())
  incidentId      String
  incident        Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  evidenceType    String
  filename        String
  sha256          String
  collectedBy     String
  collectedAt     DateTime @default(now())
  description     String?
  storagePath     String?
  fileSize        Int      @default(0)
  chainOfCustody  String   @default("[]")
  isImmutable     Boolean  @default(true)
  createdAt       DateTime @default(now())
}

model Playbook {
  id          String   @id @default(cuid())
  name        String
  description String?
  category    String   @default("incident_response")
  trigger     String   @default("manual")
  steps       String
  severity    String   @default("high")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

// ── Memory Vault (AI Memory) ─────────────────────────────────────────────────
// Persistent memory entries for the Guardian AI chat assistant — markdown-style
// "fewer fuller notes" key/value records keyed by category.
model MemoryEntry {
  id        String   @id @default(cuid())
  userId    String
  category  String   // scan_result | finding | patch | user_preference | conversation | client_context | threat_intel
  title     String
  content   String
  tags      String?  // comma-separated tags
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([userId, category, createdAt])
}

// ── Support Tickets (in-app chat widget) ─────────────────────────────────────
// Lightweight ticket log so users can file issues from the floating chat widget.
// The widget itself is stateful on the client; this table records the initial
// ticket + reply status for the admin dashboard.
model SupportTicket {
  id          String   @id @default(cuid())
  userId      String
  subject     String
  message     String
  priority    String   @default("normal") // low | normal | high | urgent
  status      String   @default("open")   // open | answered | closed
  reply       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

// ── Billing / Stripe subscriptions ───────────────────────────────────────────
// Tracks the active plan + Stripe customer/subscription IDs per user. Falls
// back to a default "free" plan if no row exists.
model Subscription {
  id                   String   @id @default(cuid())
  userId               String   @unique
  plan                 String   @default("free") // free | pro | enterprise
  status               String   @default("active") // active | canceled | past_due | trialing
  stripeCustomerId     String?
  stripeSubscriptionId String?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean  @default(false)
  // Cached usage counters (refreshed by webhook + on-demand from the panel).
  clientsUsed          Int      @default(0)
  scansUsed            Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

// ── Deepfake Phishing Simulator ──────────────────────────────────────────────
// Records each deepfake phishing simulation sent to an employee. The target
// receives an email linking to /phishing/sim?id=... — when they click, the
// page marks the row as `clicked: true, clickedAt: now()` and plays a TTS
// audio of the phishing message (CEO impersonation). After 5 seconds the page
// reveals "This was a simulation" and offers a 2-minute training redirect.
// Tracked fields: sentAt (email dispatched), clickedAt (target landed on the
// page), trainedAt (target completed training). status flows sent→clicked→
// trained | dismissed. campaignId is optional (for grouping batches).
model PhishingSimulation {
  id           String    @id @default(cuid())
  targetEmail  String
  targetName   String
  personaName  String    // "CEO Ayan Ali"
  personaRole  String    // "Founder & CEO"
  message      String    // the phishing message (also spoken by TTS)
  audioUrl     String?   // generated TTS audio (data URL) — currently unused server-side
  sentAt       DateTime  @default(now())
  clickedAt    DateTime?
  clicked      Boolean   @default(false)
  trainedAt    DateTime?
  status       String    @default("sent") // sent | clicked | trained | dismissed
  campaignId   String?

  @@index([targetEmail])
  @@index([status])
}

// ── WebsiteScan (homepage "Scan Your Website For Free") ──────────────────────
// Records every public scan run by a visitor from the homepage ScanWidget.
// Each scan runs real HTTP recon (TLS/headers/SSL/security.txt/robots.txt
// probe) and produces actual findings — no mock data. The visitor's email
// is captured so the full PDF report can be emailed.
model WebsiteScan {
  id              String   @id @default(cuid())
  url             String
  email           String?
  status          String   @default("running") // running | completed | failed
  score           Int?
  findingsCount   Int      @default(0)
  criticalCount   Int      @default(0)
  highCount       Int      @default(0)
  mediumCount     Int      @default(0)
  lowCount        Int      @default(0)
  findings        String   @default("[]") // JSON array of finding objects
  reportSent      Boolean  @default(false)
  reportPath      String?
  ipAddress       String?
  userAgent       String?
  duration        Int?
  createdAt       DateTime @default(now())
  completedAt     DateTime?

  @@index([createdAt])
  @@index([status])
  @@index([email])
}

// ── Moving Target Defense (innovation: auto-rotating secrets) ──────────────
// Each row is a tracked secret (API key, DB URL, JWT secret, OAuth token)
// whose value is regenerated on a schedule so any exfiltrated copy goes
// stale within hours. `currentValue` is stored as-is (encryption at rest
// is a future enhancement — the rotation logic itself is the defense).
// `previousValue` is kept briefly for rollback. The `nextRotation` index
// lets the sweep endpoint find every due secret in O(log n).
model SecretRotation {
  id                    String   @id @default(cuid())
  name                  String   // e.g. "STRIPE_SECRET_KEY", "DATABASE_URL"
  type                  String   // api_key | database_url | jwt_secret | oauth_token
  currentValue          String   // the current value (encrypted at rest — store as-is for now)
  previousValue         String?  // the previous value (for rollback)
  rotationIntervalHours Int      @default(24)
  lastRotated           DateTime @default(now())
  nextRotation          DateTime
  autoRotate            Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([nextRotation])
}

model RotationLog {
  id          String   @id @default(cuid())
  secretId    String
  secretName  String
  rotatedAt   DateTime @default(now())
  success     Boolean
  error       String?
}

// ── Cryptographic Canary Tokens (innovation: per-data leak tracing) ────────
// Every sensitive resource (finding, credential, client data export, API
// key) gets a unique canary token embedded invisibly. If ANY token is
// observed in the wild (dark web, GitHub gist, pastebin, …), this endpoint
// knows exactly which data path leaked it. Tokens are prefixed
// `gx_canary_` + 16 random bytes hex so they're trivially greppable.
model CanaryToken {
  id            String   @id @default(cuid())
  token         String   @unique // the actual canary string (crypto.randomBytes(16).hex)
  resourceType  String   // finding | credential | client_data | api_key
  resourceId    String   // the ID of the resource this token protects
  label         String   // human-readable: "Customer DB export — CyberShield"
  createdAt     DateTime @default(now())
  triggeredAt   DateTime?
  triggeredBy   String?  // IP / user agent / source
  triggerSource String?  // "dark_web" | "github_gist" | "pastebin" | etc.
  isActive      Boolean  @default(true)

  @@index([token])
  @@index([resourceId])
}

// ── Pay-Per-Vulnerability Ledger ─────────────────────────────────────────
// Each finding found by GuardianX creates a ledger entry with the amount
// the customer owes (in paise; ₹1 = 100 paise). Entries transition through
// `owed → invoiced → paid` (or `waived` if the finding is disputed).
model FindingsLedger {
  id           String   @id @default(cuid())
  userId       String
  findingId    String
  severity     String   // critical | high | medium | low | info
  amount       Int      // in paise (₹1 = 100 paise)
  scanId       String?
  codebaseId   String?
  status       String   @default("owed") // owed | invoiced | paid | waived
  createdAt    DateTime @default(now())
  invoicedAt   DateTime?

  @@index([userId, status])
  @@index([createdAt])
}

// ── Open-Source Security Commons ───────────────────────────────────────────
// Community-contributed detection rules. Researchers submit regex/AST
// patterns; GuardianX runs them during scans; authors earn a cut on hits.
model CommunityRule {
  id            String   @id @default(cuid())
  name          String
  description   String
  pattern       String   // regex or AST pattern
  severity      String   // critical | high | medium | low | info
  cwe           String?
  language      String
  authorId      String
  authorName    String
  authorEmail   String
  upvotes       Int      @default(0)
  downloads     Int      @default(0)
  findingsCount Int      @default(0)
  earnings      Int      @default(0) // in paise
  version       Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  isActive      Boolean  @default(true)

  @@index([authorId])
  @@index([upvotes])
}

model RuleUpvote {
  id        String   @id @default(cuid())
  ruleId    String
  userId    String
  createdAt DateTime @default(now())

  @@unique([ruleId, userId])
}

// ── DetectionRule (Adversarial AI Self-Attack) ─────────────────────────────
// Auto-generated detection rules produced by the Adversarial AI loop. Each
// rule represents a blind spot GuardianX's existing scan logic missed — the
// AI wrote this rule to close the gap. Stored patterns are either regex
// (string) or a serialized AST matcher description; the scan pipeline reads
// them at runtime. Manually-added rules also live here (autoGenerated=false).
model DetectionRule {
  id            String   @id @default(cuid())
  name          String
  description   String
  pattern       String   // regex or AST pattern (string-serialized)
  severity      String   // critical | high | medium | low
  cwe           String?
  language      String   // javascript | python | go | etc
  autoGenerated Boolean  @default(false)
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  isActive      Boolean  @default(true)
  hitsCount     Int      @default(0) // how many findings this rule has produced

  @@index([autoGenerated])
  @@index([isActive])
  @@index([language, severity])
}
