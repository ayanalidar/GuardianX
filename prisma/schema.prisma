// SentinelPatch — autonomous AI security patch pipeline.
// Data model: Codebase -> Scan -> Patch(es) -> PipelineEvent(s) + ChatMessage(s).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Codebase {
  id          String   @id @default(cuid())
  name        String
  language    String   @default("javascript")
  description String?
  sourceCode  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  scans       Scan[]
  patches     Patch[]
}

model Scan {
  id          String   @id @default(cuid())
  codebaseId  String
  codebase    Codebase @relation(fields: [codebaseId], references: [id], onDelete: Cascade)
  status      String   @default("queued") // queued | analyzing | patching | sandboxing | completed | failed
  stageLabel  String?
  startedAt   DateTime @default(now())
  completedAt DateTime?
  patches     Patch[]
  events      PipelineEvent[]
}

model Patch {
  id             String   @id @default(cuid())
  patchId        String   @unique // SP-YYYY-NNNN
  codebaseId     String
  codebase       Codebase @relation(fields: [codebaseId], references: [id], onDelete: Cascade)
  scanId         String
  scan           Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)
  title          String
  severity       String // critical | high | medium | low
  cve            String?
  affectedFile   String
  aiExplanation  String
  aiReasoning    String
  confidence     Float    @default(0)
  originalCode   String
  patchedCode    String
  diffPayload    String
  testCode       String
  sandboxLogs    String
  sandboxPassed  Boolean  @default(false)
  // PoC exploit playground
  exploitCode    String? // self-contained PoC that demonstrates exploitation
  exploitOriginalResult String? // JSON: {success, output} running exploit vs original
  exploitPatchedResult  String? // JSON: {success, output} running exploit vs patched
  // Adversarial red-team / blue-team loop
  adversarialRounds    Int      @default(0)
  adversarialWon       Boolean  @default(false) // defender won (attacker conceded)
  adversarialTranscript String? // JSON array of rounds
  status         String   @default("pending") // pending | approved | rejected
  createdAt      DateTime @default(now())
  approvedAt     DateTime?
  chatMessages   ChatMessage[]
  attestations   Attestation[]
}

model PipelineEvent {
  id        String   @id @default(cuid())
  scanId    String
  scan      Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)
  stage     String // queued | analyzing | patching | sandboxing | reviewing | completed | failed
  message   String
  level     String   @default("info") // info | success | warning | error
  meta      String?
  createdAt DateTime @default(now())
}

model ChatMessage {
  id        String   @id @default(cuid())
  patchId   String
  patch     Patch    @relation(fields: [patchId], references: [id], onDelete: Cascade)
  role      String // user | assistant
  content   String
  createdAt DateTime @default(now())
}

// Encrypted credentials for connecting to remote Git repositories.
// The secret (token/PAT) is NEVER stored in plaintext — only as an
// AES-256-GCM ciphertext + IV + auth tag, encrypted with SENTINEL_ENC_KEY.
model Credential {
  id          String   @id @default(cuid())
  label       String
  kind        String   // github | gitlab | git
  target      String   // host or org, e.g. "github.com"
  username    String?  // for generic git; github uses "x-access-token"
  secretCipher String  // base64 AES-256-GCM ciphertext of the token
  secretIv    String   // base64 12-byte nonce
  secretTag   String   // base64 16-byte auth tag
  createdAt   DateTime @default(now())
  lastUsedAt  DateTime?
  audits      CredentialAudit[]
}

model CredentialAudit {
  id           String   @id @default(cuid())
  credentialId String
  credential   Credential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  action       String   // created | decrypted | used | deleted
  context      String?  // e.g. "cloned github.com/acme/repo"
  createdAt    DateTime @default(now())
}

// ── RedAgent VAPT ───────────────────────────────────────────────────────────
// A live target URL that RedAgent is authorized to attack.

model Target {
  id          String   @id @default(cuid())
  name        String
  baseUrl     String   // e.g. http://localhost:3004
  authHeader  String?  // optional raw Authorization header for authenticated scanning
  notes       String?
  authorized  Boolean  @default(false) // user must confirm authorization
  createdAt   DateTime @default(now())
  engagements Engagement[]
}

// A single VAPT engagement (scan) against a target.

model Engagement {
  id          String   @id @default(cuid())
  targetId    String
  target      Target   @relation(fields: [targetId], references: [id], onDelete: Cascade)
  status      String   @default("queued") // queued | crawling | attacking | analyzing | completed | failed
  stageLabel  String?
  crawlSummary String? // JSON: { endpointsFound, paramsFound, ... }
  startedAt   DateTime @default(now())
  completedAt DateTime?
  findings    Finding[]
  events      RedAgentEvent[]
}

// A confirmed vulnerability found against the live target.

model Finding {
  id           String   @id @default(cuid())
  engagementId String
  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  title        String
  severity     String   // critical | high | medium | low | info
  category     String   // e.g. SQL Injection, XSS, IDOR, Path Traversal
  owasp        String?  // OWASP Top 10 category, e.g. A03:2021-Injection
  endpoint     String   // the attacked URL/path
  method       String   // GET | POST | ...
  description  String
  proofRequest String   // the HTTP request that proves it (method + url + body)
  proofResponse String  // the HTTP response evidence (status + excerpt)
  payload      String?  // the attack payload used
  confidence   Float    @default(0)
  remediation  String?
  createdAt    DateTime @default(now())
}

model RedAgentEvent {
  id           String   @id @default(cuid())
  engagementId String
  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  stage        String   // crawling | planning | attacking | analyzing | completed | failed
  message      String
  level        String   @default("info") // info | success | warning | error
  meta         String?
  createdAt    DateTime @default(now())
}

// ── Cryptographic Patch Attestation ────────────────────────────────────────
// Every approved patch is hash-chained into an immutable ledger.
// Each attestation links to the previous one via prevHash, forming a chain
// that can be independently verified for integrity (tamper-evidence).

model Attestation {
  id        String   @id @default(cuid())
  patchId   String   @unique
  patch     Patch    @relation(fields: [patchId], references: [id], onDelete: Cascade)
  prevHash  String
  hash      String
  data      String
  createdAt DateTime @default(now())
}

// ── Data Exfiltration Defense ───────────────────────────────────────────────
// Canary records: invisible fake data injected into API responses.
// If any canary value appears externally, we know the data was scraped.

model Canary {
  id          String   @id @default(cuid())
  targetId    String?
  label       String   // e.g. "Fake user: john_canary_001"
  canaryType  String   // user | product | pricing | api_key | email
  canaryValue String   @unique // the unique fake value (e.g. email, fake id)
  injectedEndpoint String // where it was injected
  isActive    Boolean  @default(true)
  detected    Boolean  @default(false)
  detectedAt  DateTime?
  detectedOn  String?  // URL where it was found
  createdAt   DateTime @default(now())
}

// API access log: every request to a monitored target.

model ApiAccessLog {
  id          String   @id @default(cuid())
  targetId    String?
  ipAddress   String
  method      String
  endpoint    String
  statusCode  Int
  userAgent   String
  responseSize Int
  timestamp   DateTime @default(now())
}

// Honeypot endpoint hits: when a scraper/attacker hits a fake endpoint.

model HoneypotHit {
  id          String   @id @default(cuid())
  targetId    String?
  endpoint    String   // the honeypot path that was hit
  ipAddress   String
  userAgent   String
  method      String
  timestamp   DateTime @default(now())
}
