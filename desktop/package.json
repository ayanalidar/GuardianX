{
  "name": "guardianx-desktop",
  "version": "1.0.0",
  "description": "GuardianX — Autonomous Security Operations Platform (Desktop App)",
  "main": "main.js",
  "author": "GuardianX",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ayanalidar/GuardianX.git"
  },
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --publish never",
    "build:portable": "electron-builder --win portable --publish never",
    "build:msi": "electron-builder --win nsis --publish never",
    "build:all": "electron-builder --win nsis portable --publish never"
  },
  "build": {
    "appId": "in.guardianx.app",
    "productName": "GuardianX",
    "copyright": "© 2026 GuardianX",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "build/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "GuardianX-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GuardianX",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "GuardianX-Portable-${version}.exe"
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
